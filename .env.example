# Copie este arquivo para ".env" e preencha com valores reais antes de rodar
# o projeto. Nenhum segredo real está neste arquivo.

# String de conexão do PostgreSQL. Em desenvolvimento local, aponte para um
# Postgres instalado na máquina; em produção, para a instância hospedada que
# você provisionar (ver README, seção "Banco de dados em produção").
DATABASE_URL="postgresql://usuario:senha@localhost:5432/tags_nfc?schema=public"

# Origem pública (domínio) usada para montar as URLs das placas, ex.:
# https://SEU_DOMINIO/p/TOKEN
#
# Enquanto este valor for "http://localhost:3000" (ou qualquer coisa que não
# seja um domínio HTTPS real e publicado), o sistema trata todos os lotes
# como "modo demonstração": os PDFs saem com marca d'água e a exportação
# "pronta para produção" fica bloqueada (ver src/lib/exportacao/gate.ts).
# Isso é intencional — evita que placas com um link que não existe de verdade
# sejam impressas e coladas em um estabelecimento.
NEXT_PUBLIC_ORIGEM_PUBLICA="http://localhost:3000"

# "desenvolvimento" | "producao" — usado só para exibição/logs, não é o que
# decide o modo de exportação (isso é feito por NEXT_PUBLIC_ORIGEM_PUBLICA).
NEXT_PUBLIC_AMBIENTE="desenvolvimento"

# Segredo usado para assinar/validar os tokens de sessão de login.
# Gere um valor aleatório forte antes de publicar, por exemplo:
#   openssl rand -hex 32
SESSION_SECRET="gere-um-valor-aleatorio-longo-antes-de-publicar"

# Token de uso único para a criação do primeiro administrador via
# /painel/setup (ver README, seção "Primeiro administrador"). Troque antes de
# publicar e descarte (ou rotacione) depois de criar o primeiro usuário.
SETUP_TOKEN="gere-um-valor-aleatorio-antes-de-publicar"
